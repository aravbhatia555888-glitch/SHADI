# ==========================================================
# ShaadiBazaar — Environment Configuration
# ==========================================================
# Copy this file to .env and fill in your actual values.
#
# QUICK START:
# 1. Create a Supabase project at https://supabase.com
# 2. Replace EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY
# 3. Run: npx expo start
#
# For AI features (checklist generator, wedding planner):
# - Add EXPO_PUBLIC_OPENAI_API_KEY (development only)
# - OR set up a backend proxy and add EXPO_PUBLIC_AI_PROXY_URL (production)
# ==========================================================

# --- Supabase (Required) ---
# Your Supabase project URL (found in Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (found in Settings > API > Project API keys)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI Features (production architecture) ---
# Direct OpenAI calls from the client were REMOVED (no code reads
# EXPO_PUBLIC_OPENAI_API_KEY anymore). All AI traffic goes through the
# ai-proxy Edge Function:
#   1. supabase functions deploy ai-proxy
#   2. supabase secrets set OPENAI_API_KEY=sk-...
# No client-side key is needed or supported.

# --- AI Proxy (REQUIRED for production) ---
# Direct OpenAI calls from the client have been REMOVED for security.
# To use AI features, you MUST set up a backend proxy and configure this URL.
# The proxy should validate requests, enforce rate limits, and store your API key server-side.
# EXPO_PUBLIC_AI_PROXY_URL=https://your-ai-proxy-url.com

# --- Google OAuth (Optional) ---
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Apple OAuth (Optional, iOS only) ---
# EXPO_PUBLIC_APPLE_SERVICE_ID=com.example.shaadibazaar

# --- Sentry (Optional for error tracking) ---
# EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@oXXXXXX.ingest.us.sentry.io/XXXXXX

# --- Razorpay Payments (Production) ---
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx (public key, safe in client)
# RAZORPAY_KEY_SECRET=your-razorpay-secret (ONLY in Supabase Edge Function env, never in .env)

# --- Firebase (Optional for analytics) ---
# EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
# EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Environment ---
# EXPO_PUBLIC_ENV=development | production
# EXPO_PUBLIC_PROJECT_ID=your-eas-project-id
